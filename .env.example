APP_ENV=development

API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

POSTGRES_DB=ai_content_factory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:15433/ai_content_factory?sslmode=disable
# Required by the API to encrypt saved configuration credentials. Use a unique secret outside source control.
CONFIGURATION_ENCRYPTION_KEY=replace-with-a-local-development-secret
CHAPTER_PLAN_IDEMPOTENCY_HMAC_SECRET=replace-with-a-local-development-chapter-plan-hmac-secret
REDIS_URL=redis://localhost:6379/0

WORKFLOW_PROVIDER=mock
CONTENT_PACKS=novel

LOG_LEVEL=info
