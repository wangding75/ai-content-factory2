{
  "iteration": "iteration-17-real-content-review",
  "status": "rebuild_candidate_2026_07_29",
  "canonicalRoutes": {
    "editor": "/projects/{projectId}/works/{workId}",
    "review": "/projects/{projectId}/works/{workId}/review",
    "history": "/projects/{projectId}/works/{workId}/review/history"
  },
  "runtimeStage": "review",
  "inputContract": "review.input.v1",
  "outputContract": "review.output.v1",
  "designSystem": "ui/DESIGN.md",
  "frameCount": 8,
  "frames": [
    {
      "order": 1,
      "frameId": "I17_D1_EDITOR_REVIEW_ENTRY",
      "title": "正文编辑器与提交审核入口",
      "type": "editor_state",
      "route": "/projects/{projectId}/works/{workId}",
      "trigger": "打开已保存正文",
      "screenPath": "ui/frames/I17_D1_EDITOR_REVIEW_ENTRY/screen.png",
      "htmlPath": "ui/frames/I17_D1_EDITOR_REVIEW_ENTRY/code.html",
      "api": [
        "getContentItem",
        "getContentReviewSummary"
      ],
      "summaryStates": [
        "idle",
        "not_configured"
      ],
      "developmentTask": "CF-17-03A",
      "acceptance": "未保存修改阻止提交；点击只打开抽屉"
    },
    {
      "order": 2,
      "frameId": "D2_SUBMIT_REVIEW_DRAWER",
      "title": "发起内容审核抽屉",
      "type": "drawer",
      "route": "/projects/{projectId}/works/{workId}",
      "trigger": "点击提交审核",
      "screenPath": "ui/frames/D2_SUBMIT_REVIEW_DRAWER/screen.png",
      "htmlPath": "ui/frames/D2_SUBMIT_REVIEW_DRAWER/code.html",
      "api": [
        "preflightContentReviewRun",
        "createContentReviewRun"
      ],
      "summaryStates": [
        "idle",
        "queued"
      ],
      "developmentTask": "CF-17-03A",
      "acceptance": "固定版本、只读工作流和维度、取消无副作用"
    },
    {
      "order": 3,
      "frameId": "STATE_TASK_RUNNING_BAR",
      "title": "内容审核运行中",
      "type": "async_state",
      "route": "/projects/{projectId}/works/{workId}/review",
      "trigger": "summary=queued|running",
      "screenPath": "ui/frames/STATE_TASK_RUNNING_BAR/screen.png",
      "htmlPath": "ui/frames/STATE_TASK_RUNNING_BAR/code.html",
      "api": [
        "getContentReviewSummary",
        "getWorkflowRunDetail",
        "listWorkflowRunEvents"
      ],
      "summaryStates": [
        "queued",
        "running"
      ],
      "developmentTask": "CF-17-03B",
      "acceptance": "可离开页面并从持久化 Run/Event 恢复"
    },
    {
      "order": 4,
      "frameId": "D2_REVIEW_V2",
      "title": "审核结果总览",
      "type": "report_state",
      "route": "/projects/{projectId}/works/{workId}/review?reportId={reviewId}",
      "trigger": "summary=review_ready",
      "screenPath": "ui/frames/D2_REVIEW_V2/screen.png",
      "htmlPath": "ui/frames/D2_REVIEW_V2/code.html",
      "api": [
        "getReviewDetail",
        "updateReviewIssue"
      ],
      "summaryStates": [
        "review_ready"
      ],
      "developmentTask": "CF-17-03B",
      "acceptance": "Report/Issue 来源完整；重写入口禁用"
    },
    {
      "order": 5,
      "frameId": "I17_D2_REVIEW_ISSUE_DETAIL",
      "title": "问题详情与全文定位",
      "type": "issue_detail_state",
      "route": "/projects/{projectId}/works/{workId}/review?reportId={reviewId}&issueId={issueId}&view=source",
      "trigger": "在全文中定位",
      "screenPath": "ui/frames/I17_D2_REVIEW_ISSUE_DETAIL/screen.png",
      "htmlPath": "ui/frames/I17_D2_REVIEW_ISSUE_DETAIL/code.html",
      "api": [
        "getReviewDetail",
        "getContentVersion",
        "updateReviewIssue"
      ],
      "summaryStates": [
        "review_ready"
      ],
      "developmentTask": "CF-17-03B",
      "acceptance": "读取来源版本只读快照，不以当前正文替换"
    },
    {
      "order": 6,
      "frameId": "STATE_TASK_FAILED_NOTICE",
      "title": "审核任务失败",
      "type": "error_state",
      "route": "/projects/{projectId}/works/{workId}/review",
      "trigger": "summary failure state",
      "screenPath": "ui/frames/STATE_TASK_FAILED_NOTICE/screen.png",
      "htmlPath": "ui/frames/STATE_TASK_FAILED_NOTICE/code.html",
      "api": [
        "getContentReviewSummary",
        "retryWorkflowRun",
        "retryReviewResultConsumption"
      ],
      "summaryStates": [
        "runtime_failed",
        "output_validation_failed",
        "result_consumption_failed"
      ],
      "developmentTask": "CF-17-03B",
      "acceptance": "区分重试类型；技术详情脱敏"
    },
    {
      "order": 7,
      "frameId": "STATE_NOT_CONFIGURED_EMPTY",
      "title": "审核工作流未配置",
      "type": "empty_state",
      "route": "/projects/{projectId}/works/{workId}/review",
      "trigger": "summary=not_configured",
      "screenPath": "ui/frames/STATE_NOT_CONFIGURED_EMPTY/screen.png",
      "htmlPath": "ui/frames/STATE_NOT_CONFIGURED_EMPTY/code.html",
      "api": [
        "getContentReviewSummary",
        "preflightContentReviewRun"
      ],
      "summaryStates": [
        "not_configured"
      ],
      "developmentTask": "CF-17-03B",
      "acceptance": "阻止创建并跳转项目工作流设置"
    },
    {
      "order": 8,
      "frameId": "I17_D2_REVIEW_HISTORY",
      "title": "审核历史",
      "type": "history_state",
      "route": "/projects/{projectId}/works/{workId}/review/history",
      "trigger": "点击审核历史",
      "screenPath": "ui/frames/I17_D2_REVIEW_HISTORY/screen.png",
      "htmlPath": "ui/frames/I17_D2_REVIEW_HISTORY/code.html",
      "api": [
        "listContentItemReviews",
        "getReviewDetail",
        "getWorkflowRunDetail"
      ],
      "summaryStates": [
        "queued",
        "running",
        "review_ready",
        "runtime_failed",
        "output_validation_failed",
        "result_consumption_failed"
      ],
      "developmentTask": "CF-17-03B",
      "acceptance": "多版本、多次 Run 和失败记录均保留"
    }
  ]
}
